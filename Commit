name: Pages build and deploy with diagnostics

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  deploy:
    name: Deploy to GitHub Pages (with diagnostics)
    runs-on: ubuntu-latest
    timeout-minutes: 60
    permissions:
      contents: read
      pages: write
      id-token: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Build site (if applicable)
        run: |
          # Ajuste os comandos de build conforme o seu projeto
          if [ -f package.json ]; then
            npm ci
            npm run build || true
          fi

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v1
        with:
          path: ./build # ajuste para o diretório gerado pela build

      - name: Dump latest Pages build status
        run: |
          set -e
          if ! command -v jq >/dev/null 2>&1; then
            sudo apt-get update && sudo apt-get install -y jq || true
          fi
          echo "Consultando builds do Pages para ${{ github.repository }}"
          curl -s -H "Authorization: Bearer ${{ secrets.GITHUB_TOKEN }}" \
            -H "Accept: application/vnd.github+json" \
            "https://api.github.com/repos/${{ github.repository }}/pages/builds" \
          | jq -r '.[0] | {id: .id, status: .status, error: .error, created_at: .created_at, updated_at: .updated_at}'

      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v1

      - name: Poll Pages build until completion
        run: |
          set -e
          if ! command -v jq >/dev/null 2>&1; then
            sudo apt-get update && sudo apt-get install -y jq || true
          fi
          OWNER_REPO="${{ github.repository }}"
          TOKEN="${{ secrets.GITHUB_TOKEN }}"
          timeout=3600
          interval=10
          start=$(date +%s)

          while true; do
            resp=$(curl -s -H "Authorization: Bearer $TOKEN" -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$OWNER_REPO/pages/builds")
            id=$(echo "$resp" | jq -r '.[0].id')
            status=$(echo "$resp" | jq -r '.[0].status')
            echo "Pages build $id status: $status"
            if [[ "$status" == "built" || "$status" == "errored" || "$status" == "failed" ]]; then
              echo "Estado final:"
              echo "$resp" | jq -r '.[0]'
              if [[ "$status" == "errored" || "$status" == "failed" ]]; then
                exit 1
              fi
              break
            fi
            now=$(date +%s)
            if (( now - start > timeout )); then
              echo "Polling timed out after $timeout seconds"
              exit 1
            fi
            sleep $interval
          done
